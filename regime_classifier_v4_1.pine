// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0

//@version=6
indicator("GHP Regime Overlay", overlay=true)

// ─── INPUTS ───
ema20Len  = input.int(20,  "EMA 20 Length")
ema50Len  = input.int(50,  "EMA 50 Length")
assessMode = input.string("Weekly", "Assessment Mode", options=["Daily", "Weekly"])
spySymbol = input.symbol("AMEX:SPY", "SPY Symbol")
vixSymbol = input.symbol("TVC:VIX", "VIX Symbol")
mmfiSymbol = input.symbol("MMFI", "MMFI Symbol (% > 50d MA)")
mmthSymbol = input.symbol("MMTH", "MMTH Symbol (% > 200d MA)")
yrhiSymbol = input.symbol("YRHI.US", "YRHI Symbol (52w Highs)")
yrloSymbol = input.symbol("YRLO.US", "YRLO Symbol (52w Lows)")
nhLookback = input.int(5, "Net Highs Lookback (days)", minval=1)
emergencyVixThreshold = input.float(35.0, "Emergency VIX Spike Threshold")
emergencyGapDown      = input.float(-4.0, "Emergency SPY Gap Down %")
tablePos = input.string("bottom_left", "Table Position", options=["top_left","top_right","bottom_left","bottom_right"])

// ─── FORCE DAILY / ANTI-REPAINT ───
spyClose_d     = request.security(spySymbol, "D", close[1], lookahead=barmerge.lookahead_on)
spyOpen_d      = request.security(spySymbol, "D", open, lookahead=barmerge.lookahead_off)
spy20_d        = request.security(spySymbol, "D", ta.ema(close, ema20Len)[1], lookahead=barmerge.lookahead_on)
spy50_d        = request.security(spySymbol, "D", ta.ema(close, ema50Len)[1], lookahead=barmerge.lookahead_on)
spyPrevClose_d = request.security(spySymbol, "D", close[2], lookahead=barmerge.lookahead_on)

vixClose_d = request.security(vixSymbol, "D", close[1], lookahead=barmerge.lookahead_on)
vix50_d    = request.security(vixSymbol, "D", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)

mmfiClose_d = request.security(mmfiSymbol, "D", close[1], lookahead=barmerge.lookahead_on)
mmthClose_d = request.security(mmthSymbol, "D", close[1], lookahead=barmerge.lookahead_on)

yrhiSum = request.security(yrhiSymbol, "D", math.sum(close, nhLookback)[1], lookahead=barmerge.lookahead_on)
yrloSum = request.security(yrloSymbol, "D", math.sum(close, nhLookback)[1], lookahead=barmerge.lookahead_on)
netHL = nz(yrhiSum) - nz(yrloSum)

// ─── DAILY SCORING (raw, computed every bar) ───
dailyC1 = spyClose_d > spy20_d ? 1 : 0
dailyC2 = spyClose_d > spy50_d ? 1 : 0
dailyC3 = spy20_d > spy50_d    ? 1 : 0
dailyC4 = mmfiClose_d > 50     ? 1 : 0
dailyC5 = mmthClose_d > 50     ? 1 : 0
dailyC6 = netHL > 0            ? 1 : 0
dailyC7 = vixClose_d < 20      ? 1 : 0
dailyC8 = vixClose_d < vix50_d ? 1 : 0

dailyScore = dailyC1 + dailyC2 + dailyC3 + dailyC4 + dailyC5 + dailyC6 + dailyC7 + dailyC8

// ─── WEEKLY ASSESSMENT (locks score on Friday close, holds all week) ───
isFriday = dayofweek == dayofweek.friday

var int weeklyC1 = 0
var int weeklyC2 = 0
var int weeklyC3 = 0
var int weeklyC4 = 0
var int weeklyC5 = 0
var int weeklyC6 = 0
var int weeklyC7 = 0
var int weeklyC8 = 0
var int weeklyScore = 0
var float weeklyMMFI = 0.0
var float weeklyMMTH = 0.0
var float weeklyNetHL = 0.0
var float weeklyVIX = 0.0
var float weeklyVIX50 = 0.0

if isFriday
    weeklyC1 := dailyC1
    weeklyC2 := dailyC2
    weeklyC3 := dailyC3
    weeklyC4 := dailyC4
    weeklyC5 := dailyC5
    weeklyC6 := dailyC6
    weeklyC7 := dailyC7
    weeklyC8 := dailyC8
    weeklyScore := dailyScore
    weeklyMMFI := mmfiClose_d
    weeklyMMTH := mmthClose_d
    weeklyNetHL := netHL
    weeklyVIX := vixClose_d
    weeklyVIX50 := vix50_d

// ─── SELECT ACTIVE SCORES BASED ON MODE ───
bool isWeekly = assessMode == "Weekly"

c1 = isWeekly ? weeklyC1 : dailyC1
c2 = isWeekly ? weeklyC2 : dailyC2
c3 = isWeekly ? weeklyC3 : dailyC3
c4 = isWeekly ? weeklyC4 : dailyC4
c5 = isWeekly ? weeklyC5 : dailyC5
c6 = isWeekly ? weeklyC6 : dailyC6
c7 = isWeekly ? weeklyC7 : dailyC7
c8 = isWeekly ? weeklyC8 : dailyC8
totalScore = isWeekly ? weeklyScore : dailyScore

// Display values: show weekly-locked values in weekly mode, live in daily
dispMMFI  = isWeekly ? weeklyMMFI  : mmfiClose_d
dispMMTH  = isWeekly ? weeklyMMTH  : mmthClose_d
dispNetHL = isWeekly ? weeklyNetHL : netHL
dispVIX   = isWeekly ? weeklyVIX   : vixClose_d
dispVIX50 = isWeekly ? weeklyVIX50 : vix50_d

// ─── EMERGENCY OVERRIDES (always daily, regardless of mode) ───
gapPct = nz(spyPrevClose_d) != 0 ? (spyOpen_d - spyPrevClose_d) / spyPrevClose_d * 100 : 0.0
emergencyOverride = vixClose_d > emergencyVixThreshold or gapPct <= emergencyGapDown

// ─── REGIME ───
scoreRegime = totalScore >= 6 ? 2 : totalScore >= 3 ? 1 : 0
regime = emergencyOverride ? 0 : scoreRegime
regimeColor = regime == 2 ? color.new(color.green, 85) : regime == 1 ? color.new(color.yellow, 85) : color.new(color.red, 85)
bgcolor(regimeColor)

// ─── DAYS IN REGIME ───
var int daysInRegime = 1
if regime == regime[1]
    daysInRegime += 1
else
    daysInRegime := 1

regimeName = regime == 2 ? "GREEN" : regime == 1 ? "YELLOW" : "RED"
modeLabel = isWeekly ? "Weekly" : "Daily"

// ─── TABLE ───
posMap = tablePos == "top_left" ? position.top_left : tablePos == "top_right" ? position.top_right : tablePos == "bottom_left" ? position.bottom_left : position.bottom_right

var table t = table.new(posMap, 3, 16, border_width=1, border_color=color.new(color.white, 85), frame_width=2, frame_color=color.new(color.white, 60))

tick(int v) =>
    v == 1 ? "✓" : "✗"

tickCol(int v) =>
    v == 1 ? #4CAF50 : #F44336

if barstate.islast
    headerBg  = regime == 2 ? #1B5E20 : regime == 1 ? #E65100 : #B71C1C
    rowBg1    = #16213E
    rowBg2    = #0F3460
    catBg     = #2C2C54
    white     = color.white
    dim       = color.new(color.white, 30)
    sz        = size.normal
    szL       = size.large

    // Row 0: Regime header
    table.cell(t, 0, 0, "  " + regimeName + "  ", text_color=white, bgcolor=headerBg, text_size=szL)
    table.cell(t, 1, 0, str.tostring(totalScore) + " / 8", text_color=white, bgcolor=headerBg, text_size=szL)
    table.cell(t, 2, 0, str.tostring(daysInRegime) + " days", text_color=white, bgcolor=headerBg, text_size=sz)

    // Row 1: Mode + Override
    table.cell(t, 0, 1, modeLabel + " Assessment", text_color=dim, bgcolor=rowBg1, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 1, "Override", text_color=emergencyOverride ? white : dim, bgcolor=emergencyOverride ? #B71C1C : rowBg1, text_size=sz)
    table.cell(t, 2, 1, emergencyOverride ? "⚠ ACTIVE" : "Clear", text_color=emergencyOverride ? #FF5252 : #4CAF50, bgcolor=emergencyOverride ? #B71C1C : rowBg1, text_size=sz)

    // Row 2: CAT 1 header
    table.cell(t, 0, 2, "Price Structure", text_color=white, bgcolor=catBg, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 2, "", bgcolor=catBg, text_size=sz)
    table.cell(t, 2, 2, str.tostring(c1+c2+c3) + " / 3", text_color=white, bgcolor=catBg, text_size=sz)

    // Row 3-5: Price Structure criteria
    table.cell(t, 0, 3, "SPY close > 20 EMA", text_color=white, bgcolor=rowBg1, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 3, tick(c1), text_color=tickCol(c1), bgcolor=rowBg1, text_size=sz)
    table.cell(t, 2, 3, "", bgcolor=rowBg1, text_size=sz)

    table.cell(t, 0, 4, "SPY close > 50 EMA", text_color=white, bgcolor=rowBg2, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 4, tick(c2), text_color=tickCol(c2), bgcolor=rowBg2, text_size=sz)
    table.cell(t, 2, 4, "", bgcolor=rowBg2, text_size=sz)

    table.cell(t, 0, 5, "20 EMA > 50 EMA", text_color=white, bgcolor=rowBg1, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 5, tick(c3), text_color=tickCol(c3), bgcolor=rowBg1, text_size=sz)
    table.cell(t, 2, 5, "", bgcolor=rowBg1, text_size=sz)

    // Row 6: CAT 2 header
    table.cell(t, 0, 6, "Market Breadth", text_color=white, bgcolor=catBg, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 6, "", bgcolor=catBg, text_size=sz)
    table.cell(t, 2, 6, str.tostring(c4+c5+c6) + " / 3", text_color=white, bgcolor=catBg, text_size=sz)

    // Row 7-9: Breadth criteria
    table.cell(t, 0, 7, "MMFI > 50%", text_color=white, bgcolor=rowBg2, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 7, tick(c4), text_color=tickCol(c4), bgcolor=rowBg2, text_size=sz)
    table.cell(t, 2, 7, str.tostring(dispMMFI, "#.#") + "%", text_color=dim, bgcolor=rowBg2, text_size=sz)

    table.cell(t, 0, 8, "MMTH > 50%", text_color=white, bgcolor=rowBg1, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 8, tick(c5), text_color=tickCol(c5), bgcolor=rowBg1, text_size=sz)
    table.cell(t, 2, 8, str.tostring(dispMMTH, "#.#") + "%", text_color=dim, bgcolor=rowBg1, text_size=sz)

    table.cell(t, 0, 9, "Net 52w Highs - Lows > 0", text_color=white, bgcolor=rowBg2, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 9, tick(c6), text_color=tickCol(c6), bgcolor=rowBg2, text_size=sz)
    table.cell(t, 2, 9, str.tostring(dispNetHL, "#"), text_color=dim, bgcolor=rowBg2, text_size=sz)

    // Row 10: CAT 3 header
    table.cell(t, 0, 10, "Volatility", text_color=white, bgcolor=catBg, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 10, "", bgcolor=catBg, text_size=sz)
    table.cell(t, 2, 10, str.tostring(c7+c8) + " / 2", text_color=white, bgcolor=catBg, text_size=sz)

    // Row 11-12: Volatility criteria
    table.cell(t, 0, 11, "VIX below 20", text_color=white, bgcolor=rowBg1, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 11, tick(c7), text_color=tickCol(c7), bgcolor=rowBg1, text_size=sz)
    table.cell(t, 2, 11, str.tostring(dispVIX, "#.##"), text_color=dim, bgcolor=rowBg1, text_size=sz)

    table.cell(t, 0, 12, "VIX below 50 EMA", text_color=white, bgcolor=rowBg2, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, 12, tick(c8), text_color=tickCol(c8), bgcolor=rowBg2, text_size=sz)
    table.cell(t, 2, 12, str.tostring(dispVIX50, "#.##"), text_color=dim, bgcolor=rowBg2, text_size=sz)

    // Row 13: Action
    string action = regime == 2 ? "100% VAR · Up to 4R via kickers · Full aggression" : regime == 1 ? "50% VAR · 0.5R max new positions · Selective entries only" : "25% VAR · 0.25R · Consider step aside · Sell all at 1R down"
    table.cell(t, 0, 13, action, text_color=white, bgcolor=color.new(headerBg, 20), text_size=sz, text_halign=text.align_left)
    table.merge_cells(t, 0, 13, 2, 13)

// ─── ALERTS ───
alertcondition(regime == 2 and regime[1] != 2, title="Regime → GREEN", message="CTS Regime upgraded to GREEN (score {{plot_0}})")
alertcondition(regime == 1 and regime[1] != 1, title="Regime → YELLOW", message="CTS Regime changed to YELLOW (score {{plot_0}})")
alertcondition(regime == 0 and regime[1] != 0, title="Regime → RED", message="CTS Regime downgraded to RED (score {{plot_0}})")
alertcondition(emergencyOverride and not emergencyOverride[1], title="Emergency Override", message="⚠ EMERGENCY OVERRIDE: Regime forced to RED")

plot(totalScore, "Score", display=display.status_line)
